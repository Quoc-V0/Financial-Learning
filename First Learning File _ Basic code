      "source": [
        "# Calculate mean daily returns for each asset\n",
        "mean_daily_returns = data.mean()\n",
        "\n",
        "# Calculate portfolio mean daily return (assuming equal weights)\n",
        "portfolio_mean_daily_return = np.sum(mean_daily_returns * weights)\n",
        "\n",
        "# Annualize the portfolio return (assuming 252 trading days)\n",
        "portfolio_return_annualized = portfolio_mean_daily_return * annualizing_factor\n",
        "\n",
        "# Assume a risk-free rate (e.g., 2% per annum)\n",
        "risk_free_rate = 0.02\n",
        "\n",
        "# Calculate Sharpe Ratio\n",
        "sharpe_ratio = (portfolio_return_annualized - risk_free_rate) / portfolio_volatility_annualized\n",
        "\n",
        "print(f\"Annualized Portfolio Return: {portfolio_return_annualized:.4f}\")\n",
        "print(f\"Assumed Risk-Free Rate: {risk_free_rate:.4f}\")\n",
        "print(f\"Sharpe Ratio: {sharpe_ratio:.4f}\")"
      ],
