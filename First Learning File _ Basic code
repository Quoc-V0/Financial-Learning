      "source": [
        "num_assets = len(data.columns)\n",
        "\n",
        "# Define variables for optimization\n",
        "optimal_weights = cp.Variable(num_assets)\n",
        "\n",
        "# Define portfolio return and volatility functions\n",
        "portfolio_return = cp.sum(cp.multiply(mean_daily_returns.values, optimal_weights)) * annualizing_factor\n",
        "portfolio_volatility = cp.sqrt(cp.quad_form(optimal_weights, cov_matrix)) * np.sqrt(annualizing_factor)\n",
        "\n",
        "# Define the objective: Maximize Sharpe Ratio.\n",
        "# Since cvxpy can only minimize, we minimize the negative Sharpe Ratio.\n",
        "# We need to make sure portfolio_volatility is always positive.\n",
        "# For maximization of Sharpe ratio with positive expected return, this formulation is equivalent.\n",
        "objective = cp.Maximize((portfolio_return - risk_free_rate) / portfolio_volatility)\n",
        "\n",
        "# Define constraints\n",
        "constraints = [\n",
        "    cp.sum(optimal_weights) == 1,  # Weights must sum to 1\n",
        "    optimal_weights >= 0           # No short selling (weights must be non-negative)\n",
        "]\n",
        "\n",
        "# Create the problem and solve it\n",
        "problem = cp.Problem(objective, constraints)"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "407b9099"
      },
      "source": [
        "problem.solve(solver='ECOS')\n",
        "\n",
        "# Display the results\n",
        "if problem.status == cp.OPTIMAL or problem.status == cp.OPTIMAL_INACCURATE:\n",
        "    print(\"Optimal Weights (to maximize Sharpe Ratio):\")\n",
        "    optimal_weights_values = optimal_weights.value\n",
        "    for i, ticker in enumerate(data.columns):\n",
        "        print(f\"  {ticker}: {optimal_weights_values[i]:.4f}\")\n",
        "\n",
        "    # Recalculate max Sharpe Ratio using optimal weights\n",
        "    max_portfolio_return = (np.sum(mean_daily_returns.values * optimal_weights_values)) * annualizing_factor\n",
        "    max_portfolio_volatility = np.sqrt(optimal_weights_values.T @ cov_matrix @ optimal_weights_values) * np.sqrt(annualizing_factor)\n",
        "    max_sharpe_ratio = (max_portfolio_return - risk_free_rate) / max_portfolio_volatility\n",
        "\n",
        "    print(f\"\\nMaximum Annualized Portfolio Return: {max_portfolio_return:.4f}\")\n",
        "    print(f\"Maximum Annualized Portfolio Volatility: {max_portfolio_volatility:.4f}\")\n",
        "    print(f\"Maximum Sharpe Ratio: {max_sharpe_ratio:.4f}\")\n",
        "else:\n",
        "    print(f\"Problem did not converge to an optimal solution. Status: {problem.status}\")"
