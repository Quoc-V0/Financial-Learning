      "source": [
        "num_assets = len(data.columns)\n",
        "weights = np.array([1/num_assets] * num_assets)\n",
        "\n",
        "# Calculate daily portfolio variance\n",
        "cov_matrix = data.cov()\n",
        "portfolio_variance_daily = weights.T @ cov_matrix @ weights\n",
        "\n",
        "# Annualize portfolio variance (assuming 252 trading days in a year)\n",
        "annualizing_factor = 252 # For daily data\n",
        "portfolio_variance_annualized = portfolio_variance_daily * annualizing_factor\n",
        "\n",
        "# Calculate annualized portfolio volatility\n",
        "portfolio_volatility_annualized = np.sqrt(portfolio_variance_annualized)\n",
        "\n",
        "print(f\"Annualized Portfolio Volatility: {portfolio_volatility_annualized:.4f}\")"
      ],
      "execution_count": 7,
