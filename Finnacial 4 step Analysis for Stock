    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from math import exp, log, sqrt\n",
        "from scipy.stats import norm\n",
        "from datetime import datetime\n",
        "\n",
        "pd.set_option(\"display.float_format\", lambda x: f\"{x:,.4f}\")\n",
        "\n",
        "# %% ---------- CELL 2: YOUR SETTINGS (only edit this cell) ----------\n",
        "TICKER        = \"AAPL\"    # underlying stock\n",
        "TARGET_DAYS   = 30        # option should expire in about this many days\n",
        "STRIKE        = None      # e.g. 250.0 ; None = automatically pick the at-the-money strike\n",
        "LOOKBACK_DAYS = 90        # calendar days of price history for the volatility\n",
        "DAY_COUNT     = 360       # daily rate = annual rate / 360 (per class instructions)\n",
        "N_STEPS       = 4         # 4-step tree\n",
        "\n",
        "# If Yahoo Finance is unavailable, set USE_MANUAL = True and fill these in:\n",
        "USE_MANUAL = False\n",
        "MANUAL = dict(\n",
        "    S0=100.0, strike=102.0, premium=2.10, annual_rf=0.043, daily_vol=0.015, days=30,\n",
        ")\n",
        "\n",
        "# %% ---------- CELL 3: get the market data (Steps 1-3) ----------\n",
        "def get_market_data():\n",
        "    if USE_MANUAL:\n",
        "        m = MANUAL\n",
        "        return dict(ticker=TICKER, S0=m[\"S0\"], K=m[\"strike\"], premium=m[\"premium\"],\n",
        "                    rf=m[\"annual_rf\"], sigma=m[\"daily_vol\"], days=m[\"days\"],\n",
        "                    expiry=\"manual\", prices=None)\n",
        "    import yfinance as yf\n",
        "    tk = yf.Ticker(TICKER)\n",
        "\n",
        "    # Step 3: daily std. deviation of returns of the underlying\n",
        "    hist = tk.history(period=f\"{LOOKBACK_DAYS}d\")[\"Close\"].dropna()\n",
        "    rets = np.log(hist / hist.shift(1)).dropna()\n",
        "    sigma = float(rets.std(ddof=1))\n",
        "    S0 = float(hist.iloc[-1])\n",
        "\n",
        "    # Step 1: choose the expiry closest to TARGET_DAYS\n",
        "    today = datetime.now().date()\n",
        "    exps = tk.options\n",
        "    days_to = {e: (datetime.strptime(e, \"%Y-%m-%d\").date() - today).days for e in exps}\n",
        "    expiry = min(days_to, key=lambda e: abs(days_to[e] - TARGET_DAYS))\n",
        "    calls = tk.option_chain(expiry).calls\n",
        "    strike = STRIKE if STRIKE else float(calls.iloc[(calls[\"strike\"] - S0).abs().argmin()][\"strike\"])\n",
        "    row = calls[calls[\"strike\"] == strike]\n",
        "    if row.empty:\n",
        "        raise ValueError(f\"Strike {strike} not listed for {expiry}. Available: {list(calls['strike'])}\")\n",
        "    row = row.iloc[0]\n",
        "    premium = (row[\"bid\"] + row[\"ask\"]) / 2 if row[\"bid\"] > 0 and row[\"ask\"] > 0 else float(row[\"lastPrice\"])\n",
        "\n",
        "    # Step 2: risk-free rate (13-week T-bill yield, ^IRX, quoted in %)\n",
        "    rf = float(yf.Ticker(\"^IRX\").history(period=\"5d\")[\"Close\"].dropna().iloc[-1]) / 100\n",
        "\n",
        "    return dict(ticker=TICKER, S0=S0, K=strike, premium=float(premium), rf=rf,\n",
        "                sigma=sigma, days=days_to[expiry], expiry=expiry, prices=hist)\n",
        "\n",
        "D = get_market_data()\n",
        "rf_daily = D[\"rf\"] / DAY_COUNT\n",
        "\n",
        "summary = pd.Series({\n",
        "    \"Underlying\": D[\"ticker\"], \"Expiration\": D[\"expiry\"], \"Days to expiry\": D[\"days\"],\n",
        "    \"Stock price today (S0)\": D[\"S0\"], \"Strike (X)\": D[\"K\"],\n",
        "    \"Market premium of call\": D[\"premium\"],\n",
        "    \"Annual risk-free rate\": D[\"rf\"], \"Daily risk-free rate (R/360)\": rf_daily,\n",
        "    \"Daily std. deviation\": D[\"sigma\"],\n",
        "})\n",
        "print(summary.to_string())\n",
        "\n",
        "# %% ---------- CELL 4: the binomial engine (Step 0 - 4) ----------\n",
        "def binomial_american_call(S0, K, u, d, p, disc, n=4):\n",
        "    \"\"\"American call on an n-step recombining tree.\n",
        "    Node (i, j) = step i, j up-moves.  disc = per-step discount factor = exp(-r*dt).\n",
        "    At every node:  value = MAX( exercise now (S-K) , hold = disc*[p*Cu + (1-p)*Cd] )\n",
        "    \"\"\"\n",
        "    S = np.full((n + 1, n + 1), np.nan)\n",
        "    H = np.full((n + 1, n + 1), np.nan)   # hold / continuation value\n",
        "    C = np.full((n + 1, n + 1), np.nan)   # American call value\n",
        "    for i in range(n + 1):\n",
        "        for j in range(i + 1):\n",
        "            S[i, j] = S0 * (u ** j) * (d ** (i - j))\n",
        "    for j in range(n + 1):\n",
        "        C[n, j] = max(S[n, j] - K, 0.0)\n",
        "    for i in range(n - 1, -1, -1):\n",
        "        for j in range(i + 1):\n",
        "            H[i, j] = disc * (p * C[i + 1, j + 1] + (1 - p) * C[i + 1, j])\n",
        "            C[i, j] = max(S[i, j] - K, H[i, j])\n",
        "    early = (C > H + 1e-9) & ~np.isnan(H)          # nodes where exercising early is optimal\n",
        "    return S, H, C, early\n",
        "\n",
        "def class_method(sigma, r_daily):\n",
        "    \"\"\"EXACTLY as instructed: u = EXP(daily vol), d = 1/u, p = (EXP(daily rf) - d)/(u - d), 1 step = 1 day.\"\"\"\n",
        "    u = exp(sigma); d = 1 / u\n",
        "    p = (exp(r_daily) - d) / (u - d)\n",
        "    disc = exp(-r_daily)                        # *EXP(-rT) instead of /(1+rf)\n",
        "    return u, d, p, disc\n",
        "\n",
        "def scaled_method(sigma, r_daily, days, n):\n",
        "    \"\"\"Same tree, but the n steps are spread over the option's whole life.\"\"\"\n",
        "    dt = days / n\n",
        "    u = exp(sigma * sqrt(dt)); d = 1 / u\n",
        "    r_step = r_daily * dt\n",
        "    p = (exp(r_step) - d) / (u - d)\n",
        "    disc = exp(-r_step)\n",
        "    return u, d, p, disc\n",
        "\n",
        "def black_scholes_call(S0, K, sigma, r_daily, days):\n",
        "    st = sigma * sqrt(days)\n",
        "    d1 = (log(S0 / K) + r_daily * days) / st + 0.5 * st\n",
        "    return S0 * norm.cdf(d1) - K * exp(-r_daily * days) * norm.cdf(d1 - st)\n",
        "\n",
        "# %% ---------- CELL 5: run both versions ----------\n",
        "S0, K = D[\"S0\"], D[\"K\"]\n",
        "results = {}\n",
        "for name, (u, d, p, disc) in {\n",
        "    \"Class method (1 step = 1 day)\": class_method(D[\"sigma\"], rf_daily),\n",
        "    \"Time-scaled (steps span full life)\": scaled_method(D[\"sigma\"], rf_daily, D[\"days\"], N_STEPS),\n",
        "}.items():\n",
        "    S, H, C, early = binomial_american_call(S0, K, u, d, p, disc, N_STEPS)\n",
        "    results[name] = dict(u=u, d=d, p=p, disc=disc, S=S, H=H, C=C, early=early, price=C[0, 0])\n",
        "\n",
        "params = pd.DataFrame({k: {\"u\": v[\"u\"], \"d\": v[\"d\"], \"p\": v[\"p\"], \"1-p\": 1 - v[\"p\"],\n",
        "                           \"Discount/step\": v[\"disc\"]} for k, v in results.items()})\n",
        "print(\"\\nTREE PARAMETERS\\n\", params)\n",
        "\n",
        "bs = black_scholes_call(S0, K, D[\"sigma\"], rf_daily, D[\"days\"])\n",
        "\n",
        "# %% ---------- CELL 6: compare model vs. market premium ----------\n",
        "comp = pd.DataFrame({\n",
        "    \"Price ($)\": [D[\"premium\"]] + [v[\"price\"] for v in results.values()] + [bs],\n",
        "}, index=[\"Market premium\", *results.keys(), \"Black-Scholes (benchmark)\"])\n",
        "comp[\"vs. market ($)\"] = D[\"premium\"] - comp[\"Price ($)\"]\n",
        "comp[\"vs. market (%)\"] = comp[\"vs. market ($)\"] / comp[\"Price ($)\"] * 100\n",
        "print(\"\\nPRICE COMPARISON\\n\", comp)\n",
        "\n",
        "cls = results[\"Class method (1 step = 1 day)\"][\"price\"]\n",
        "gap = (D[\"premium\"] - cls) / cls if cls else float(\"nan\")\n",
        "if abs(gap) <= 0.05:\n",
        "    verdict = \"FAIRLY PRICED: market premium is within 5% of the class-method binomial value.\"\n",
        "elif gap > 0:\n",
        "    verdict = f\"OVERPRICED: market premium is {gap:.1%} above the class-method binomial value.\"\n",
        "else:\n",
        "    verdict = f\"UNDERPRICED: market premium is {-gap:.1%} below the class-method binomial value.\"\n",
        "print(\"\\nVERDICT (class method):\", verdict)\n",
        "print(\"Note: with no dividends an American call is never exercised early, so it should equal the European (Black-Scholes) value.\")\n",
        "\n",
        "# %% ---------- CELL 7: draw the trees ----------\n",
        "def draw_tree(res, title, n=N_STEPS):\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(16, 6.5))\n",
        "    for ax, (mat, label, fmt) in zip(axes, [(res[\"S\"], \"Stock price tree\", \"{:,.2f}\"),\n",
        "                                             (res[\"C\"], \"American call value\", \"{:,.3f}\")]):\n",
        "        for i in range(n + 1):\n",
        "            for j in range(i + 1):\n",
        "                x, y = i, 2 * j - i\n",
        "                if i < n:\n",
        "                    for jj in (j, j + 1):\n",
        "                        ax.plot([x, x + 1], [y, 2 * jj - (i + 1)], color=\"#9DB7D5\", lw=1, zorder=1)\n",
        "                is_early = (mat is res[\"C\"]) and res[\"early\"][i, j]\n",
        "                itm = (mat is res[\"C\"]) and i == n and mat[i, j] > 0\n",
        "                color = \"#FFC000\" if is_early else \"#A9D08E\" if itm else (\"#DDEBF7\" if mat is res[\"S\"] else \"#E2EFDA\")\n",
        "                ax.text(x, y, fmt.format(mat[i, j]), ha=\"center\", va=\"center\", fontsize=9, fontweight=\"bold\",\n",
        "                        bbox=dict(boxstyle=\"round,pad=0.35\", fc=color, ec=\"#1F3864\"), zorder=2)\n",
        "        ax.set_xticks(range(n + 1)); ax.set_xticklabels([f\"t{'+'+str(i) if i else ''}\" for i in range(n + 1)])\n",
        "        ax.set_yticks([]); ax.set_title(label, fontweight=\"bold\", color=\"#1F3864\")\n",
        "        ax.set_xlim(-0.5, n + 0.5); ax.set_ylim(-n - 1, n + 1)\n",
        "        for s in (\"top\", \"right\", \"left\"): ax.spines[s].set_visible(False)\n",
        "    fig.suptitle(f\"{title}   |   Call price = ${res['price']:.4f}   (orange = early exercise optimal)\",\n",
        "                 fontsize=13, fontweight=\"bold\")\n",
        "    plt.tight_layout(); plt.show()\n",
        "\n",
        "for name, res in results.items():\n",
        "    draw_tree(res, name)\n",
        "\n",
        "# Bar chart: market vs models\n",
        "ax = comp[\"Price ($)\"].plot(kind=\"bar\", color=[\"#FFC000\", \"#1F3864\", \"#7030A0\", \"#548235\"], figsize=(9, 4.5), rot=15)\n",
        "ax.set_title(\"Market premium vs. model prices\", fontweight=\"bold\"); ax.set_ylabel(\"$\")\n",
        "for c in ax.containers: ax.bar_label(c, fmt=\"$%.2f\")\n",
        "plt.tight_layout(); plt.show()\n",
        "\n",
        "# %% ---------- CELL 8: (optional) export the tables to Excel ----------\n",
        "def tree_table(mat, n=N_STEPS):\n",
        "    return pd.DataFrame(mat, index=[f\"{j} ups\" for j in range(n + 1)],\n",
        "                        columns=[f\"t{'+'+str(i) if i else ''}\" for i in range(n + 1)]).iloc[::-1]\n",
        "\n",
        "with pd.ExcelWriter(\"binomial_results.xlsx\") as xw:\n",
        "    summary.to_frame(\"Value\").to_excel(xw, sheet_name=\"Summary\")\n",
        "    params.to_excel(xw, sheet_name=\"Parameters\")\n",
        "    comp.to_excel(xw, sheet_name=\"Comparison\")\n",
        "    for k, v in results.items():\n",
        "        short = \"Class\" if k.startswith(\"Class\") else \"Scaled\"\n",
        "        tree_table(v[\"S\"]).to_excel(xw, sheet_name=f\"{short} - Stock\")\n",
        "        tree_table(v[\"H\"]).to_excel(xw, sheet_name=f\"{short} - Hold\")\n",
        "        tree_table(v[\"C\"]).to_excel(xw, sheet_name=f\"{short} - Option\")\n",
        "print(\"Saved binomial_results.xlsx  (in Colab: Files panel on the left -> download)\")"
      ],
